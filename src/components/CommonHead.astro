---
import { ClientRouter } from "astro:transitions";

const { title, isPost = false, description = "" } = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
---

<meta charset="UTF-8" />

<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="color-scheme" content="light dark" />

<link rel="icon" href="/favicon.ico" sizes="32x32" />
<link rel="icon" href="/favicon.png" />
<link rel="apple-touch-icon" href="/favicon.png" />
<link rel="sitemap" href="/sitemap-index.xml" />
<meta name="generator" content={Astro.generator} />

<title>{`${title ? `${title} - ` : ""}tekno world`}</title>

<meta property="og:title" content={title ? `${title}` : "tekno world"} />
<link rel="canonical" href={canonicalUrl} />

<meta property="og:url" content={canonicalUrl} />
<meta property="og:site_name" content="tekno world" />
<meta property="og:type" content={isPost ? "article" : "website"} />
<meta
  property="og:description"
  content={isPost ? description || "" : "welcome"}
/>
<meta
  property="og:image"
  content={new URL("/favicon.png", Astro.site ?? Astro.url)}
/>
<meta property="og:image:width" content="134" />
<meta property="og:image:height" content="134" />
<meta property="og:image:alt" content="tekno world logo" />
<meta name="twitter:card" content="summary" />

<meta name="theme-color" content="#9e50bf" />

{isPost && (
  // stop giscus from making links to localhost
  <meta
    name="giscus:backlink"
    content={`https://tekno.sh${Astro.url.pathname}`}
  />
)}

<script is:inline>
  globalThis.ThemeProvider = (() => {
    // localStorage can throw (blocked site data, some private modes), so fall
    // back to an in-memory preference for the session
    let memoryPreference = "system";

    const getPreference = () => {
      try {
        return localStorage.theme ?? "system";
      } catch {
        return memoryPreference;
      }
    };

    const setPreference = (preference) => {
      memoryPreference = preference;
      try {
        if (preference === "system") localStorage.removeItem("theme");
        else localStorage.theme = preference;
      } catch {}
    };

    const isDarkTheme = () => {
      const preference = getPreference();
      return (
        preference === "dark" ||
        (preference === "system" &&
          globalThis.matchMedia("(prefers-color-scheme: dark)").matches)
      );
    };

    const applyTheme = (document_ = document) => {
      document_.documentElement.classList.toggle("dark", isDarkTheme());

      document.dispatchEvent(
        new CustomEvent("theme-change", {
          detail: {
            theme: isDarkTheme() ? "dark" : "light",
          },
        }),
      );
    };

    document.addEventListener("astro:before-swap", (event) =>
      applyTheme(event.newDocument),
    );

    applyTheme();

    return {
      getPreference,
      setPreference,
      isDarkTheme,
      applyTheme,
    };
  })();
</script>
<script is:inline>
  // lets css know js is running (the js: variant)
  document.documentElement.classList.add("js");
  document.addEventListener("astro:before-swap", (event) =>
    event.newDocument.documentElement.classList.add("js"),
  );
</script>
<script is:inline>
  // workaround for an astro bug: the client router sets scroll restoration to manual and restores scroll
  // itself after load, which paints a frame at the top on refresh. hand it back to the browser on unload
  // so it restores natively. astro's router never resets it (as of astro 7.3.4 / main in 2026-09):
  // https://github.com/withastro/astro/blob/main/packages/astro/src/transitions/router.ts
  //
  // same approach other routers use:
  // - react router's <ScrollRestoration /> (pagehide -> auto, persisted pageshow -> manual):
  //   https://github.com/remix-run/react-router/blob/2d9827bc09bc562647553f8abf026823e3bfd9dd/packages/react-router/lib/dom/lib.tsx#L3084-L3113
  // - sveltekit (beforeunload -> auto, "adopted from nuxt"):
  //   https://github.com/sveltejs/kit/blob/c6f9a786e1ccd3b6dc91d97637299ffe8283fc2f/packages/kit/src/runtime/client/client.js#L2657-L2689
  // - nuxt 2 (beforeunload -> auto, load -> manual):
  //   https://github.com/nuxt/nuxt/blob/e265ef39d4e96b13a2cb3475731a3d794a18429c/packages/vue-app/template/router.scrollBehavior.js#L7-L23
  addEventListener("pagehide", () => {
    history.scrollRestoration = "auto";
  });
  // back on manual when restored from bfcache, otherwise back/forward would jump before the router swaps
  addEventListener("pageshow", (event) => {
    if (event.persisted) history.scrollRestoration = "manual";
  });
</script>
<noscript>
  <style>
    .requires-js {
      display: none;
    }
  </style>
</noscript>

<ClientRouter />
