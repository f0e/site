<theme-switcher class="requires-js block">
  <span class="opacity-50">theme: </span>
  <button class="cursor-pointer underline">system</button>
</theme-switcher>

<script>
  /* i'd love to set the label in an inline script so it updates instantly,
  but that apparently stops the rest of the site from rendering??

  for proof, add this above, reload lots of times and watch the layout shift:

  <script is:inline>
    // literally nothing
  < /script>
  */
  const themes = ["system", "light", "dark"];

  class ThemeSwitcher extends HTMLElement {
    connectedCallback() {
      const button = this.querySelector("button")!;

      const render = () =>
        (button.textContent = localStorage.theme ?? "system");

      button.addEventListener("click", () => {
        const current = localStorage.theme ?? "system";
        const next = themes[(themes.indexOf(current) + 1) % themes.length];

        if (next === "system") localStorage.removeItem("theme");
        else localStorage.theme = next;

        globalThis.ThemeProvider.applyTheme();
        render();
      });

      render();
    }
  }

  customElements.define("theme-switcher", ThemeSwitcher);
</script>
